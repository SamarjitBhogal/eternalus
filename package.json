{
  "name": "eternalus",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based 2D game: TypeScript monorepo with a custom Canvas engine.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run dev -w @eternalus/client",
    "build": "tsc -b && npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run test:coverage && npm run build",
    "check:quick": "npm run typecheck && npm run lint",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
