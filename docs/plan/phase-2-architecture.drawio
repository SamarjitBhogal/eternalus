        <mxCell id="c3" value="Eternalus — Phase 2 architecture" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#1a7fa6;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1300" height="38" as="geometry"/></mxCell>
