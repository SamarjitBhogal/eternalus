{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "apps/client": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@eternalus/core"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    },
    "apps/server": {
      "entry": ["src/main.ts", "src/bots/main.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": false,
  "includeEntryExports": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  }
}
