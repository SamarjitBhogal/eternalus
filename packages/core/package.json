{
  "name": "@eternalus/core",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic game simulation. Pure TypeScript: no DOM, no React, no Canvas.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
