{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite",
    "PONYTAIL_SUBAGENT_MATCHER": "^(general-purpose|test-writer|fork|claude)$"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run knip)",
      "Bash(npm run format)",
      "Bash(npm run format:*)",
      "Bash(npm run docs:*)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(git worktree list)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main*)",
      "Bash(git push * phase/*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(gh pr merge *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard*)",
      "Bash(git checkout main)",
      "Bash(git switch main)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)",
      "Read(./.env*)",
      "Read(./**/dist/**/*)",
      "Read(./**/coverage/**/*)",
      "Edit(./package-lock.json)",
      "Edit(./.githooks/**)",
      "Edit(./.github/workflows/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/session-start.mjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/post-edit.mjs"],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/stop-check.mjs"],
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
