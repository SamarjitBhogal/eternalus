{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/client-node.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  // ADR 0025 §1: the error-reports plugin sits beside vite.config.ts and joins this project, with
  // the one page file it shares (the endpoint path and the note limit).
  "include": [
    "vite.config.ts",
    "vite.config.test.ts",
    "vitest.config.ts",
    "errorReportsPlugin.ts",
    "errorReportsPlugin.constants.ts",
    "errorReportsPlugin.test.ts",
    "src/data/logging/ErrorReport.constants.ts"
  ]
}
