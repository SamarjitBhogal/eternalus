# systemd user unit that serves the static client build (127.0.0.1:5181), for a demo host.
# Install: copy to ~/.config/systemd/user/, then see apps/server/deploy/README.md.
[Unit]
Description=Eternalus client (static build)
After=network.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 5181 --bind 127.0.0.1 --directory %h/.local/share/eternalus-client
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
