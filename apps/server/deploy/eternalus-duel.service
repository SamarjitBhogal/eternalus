# systemd user unit for the Duel server (WebSocket 127.0.0.1:8787, /health on 127.0.0.1:8788).
# Install: copy to ~/.config/systemd/user/, then see apps/server/deploy/README.md.
# ExecStart needs Node 24 (the root `engines` field): point it at your Node 24 binary.
[Unit]
Description=Eternalus Duel server
After=network.target

[Service]
WorkingDirectory=%h/.local/share/eternalus-duel/server
ExecStart=/usr/bin/node main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
